{
  "name": "kiosk-vision-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Accessible Touchscreen & Conversational Voice Kiosk System",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "build": "cd frontend && npm install && npm run build",
    "start": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
